#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

# The version bump is computed in prepare-commit-msg, where the commit message
# (and therefore the feat/non-feat type) is available. Here we only validate the
# current identifier so a malformed VERSION still blocks the commit early.
old=$(read_version) || exit 1
validate_identifier "$old"