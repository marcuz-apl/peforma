#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

msgfile=$1
[ -f "$msgfile" ] || exit 0

cur=$(read_version) || exit 1
validate_identifier "$cur"

# First non-comment subject line.
line=$(awk '!/^#/ && NF { print; exit }' "$msgfile")

# If the subject already carries the current identifier, this is an amend or a
# re-run (including the post-commit fold): keep the version, do not bump again.
case "$line" in
  "$cur "*) new=$cur ;;
  *)
    bare=$(printf '%s' "$line" | sed -E 's/^v[0-9]+\.[0-9]+\.[0-9]+[+-][0-9]{6}[0-9a-zA-Z] //')
    bump=$(detect_bump_type "$bare")
    new=$(next_identifier "$cur" "$(utc_yymmdd)" "$bump") || exit 1
    printf '%s\n' "$new" > "$VERSION_FILE"
    newver=$(printf '%s' "${new#v}" | sed -E 's/[+-][0-9]{6}[0-9A-Za-z]$//')
    node "$HOOKDIR/sync-manifest-version.mjs" "$newver" || exit 1
    git add -- "$VERSION_FILE" package.json package-lock.json
    ;;
esac

tmp=$(mktemp) || exit 1
awk -v stamp="$new" '
  !done && $0 !~ /^#/ {
    sub(/^v[0-9]+\.[0-9]+\.[0-9]+[+-][0-9][0-9][0-9][0-9][0-9][0-9][0-9a-zA-Z] /, "")
    print stamp " " $0
    done = 1
    next
  }
  { print }
' "$msgfile" > "$tmp" && mv -f -- "$tmp" "$msgfile"